{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retry-semantics.local/schemas/paper_run_metadata_schema_v2.json",
  "title": "Primary CREATE V1.3 durable run metadata — prospective evidence V2",
  "description": "Run-wide non-treatment provenance, durably written before the first scheduled boundary and retained independently of arm traces. Commit and timestamp follow frozen trace rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "manifest_sha256",
    "paper_experiment_revision",
    "execution_semantics_revision",
    "git_commit",
    "timestamp",
    "collection_evidence_revision"
  ],
  "properties": {
    "schema_version": {
      "const": "paper-run-metadata-v2"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "paper_experiment_revision": {
      "const": "primary-create-v1.3"
    },
    "execution_semantics_revision": {
      "const": "primary-create-v1.2"
    },
    "git_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt][0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:[Zz]|[+-][0-9]{2}:[0-9]{2})$"
    },
    "collection_evidence_revision": {
      "const": "paper-collection-evidence-v2"
    }
  }
}
